# Copy to .env (which is gitignored) and fill in.
# From browser devtools → Application → Cookies → pathofexile.com
POESESSID=

# Optional overrides
POE2_LEAGUE=Standard
POE2_CONTACT=you@example.com

# Optional Telegram notifications. Both required to enable; leave blank to
# disable. Bot setup: open Telegram -> @BotFather -> /newbot -> copy token.
# Chat id: message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
